select *  from (select * from (select * from AA5  limit 400 )as v1 where time>2024-11-21T08:10:00.000+08:00)as vv1 full outer join (select * from (select * from AA5  limit 400 )as v2 where time<2024-11-21T08:10:00.000+08:00)as vv2 on vv1.time=vv2.time where vv1.sensor_id like '5DVL039KA' and (vv2.sensor_id='5RAZ032VZT3' or vv2.sensor_id like '5DVL039K_') and vv1.value>-1 or vv2.value=0   fill METHOD constant 120000 order by vv1.sensor_id nulls last,vv2.sensor_id desc nulls first offset 110 limit 5 ;
select count(*) from (select *  from (select * from (select * from AA5  limit 400 )as v1 where time>2024-11-21T08:10:00.000+08:00)as vv1 full outer join (select * from (select * from AA5  limit 400 )as v2 where time<2024-11-21T08:10:00.000+08:00)as vv2 on vv1.time=vv2.time where vv1.sensor_id like '5DVL039KA' and (vv2.sensor_id='5RAZ032VZT3' or vv2.sensor_id like '5DVL039K_') and vv1.value>-1 or vv2.value=0   fill METHOD constant 120000 order by vv1.sensor_id nulls last,vv2.sensor_id desc nulls first offset 110 limit 5 );
