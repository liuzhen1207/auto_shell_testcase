select sensor_id,count(*) from AA5 where sensor_id like '5R_%5P%_TD' group by sensor_id;
select sensor_id,value,count(*) from AA5 where sensor_id like '5R_%5P%_TD' group by sensor_id,2;
SELECT date_bin(1h, time) AS hour_time, sensor_id, avg(value) FROM AA5  WHERE time >= 2024-11-27 00:00:00  and time <= 2024-11-29 00:00:00   GROUP BY date_bin(1h, time), sensor_id;
SELECT date_bin(1h, time) AS hour_time, sensor_id, avg(value) FROM AA5  WHERE time >= 2024-11-22 00:00:00  and time <= 2024-11-22 01:00:00 and sensor_id like '5VV__________' and sensor_id like '5VV%19'  GROUP BY date_bin(1h, time), sensor_id;
SELECT date_bin(1h, time) AS hour_time, sensor_id, avg(value) FROM AA5  WHERE time >= 2024-11-22 00:00:00  and time <= 2024-11-22 01:00:00 and sensor_id like '5VV__________' and sensor_id like '5VV%19'  GROUP BY date_bin(1h, time), sensor_id having avg(value)>1;
SELECT max(value) FROM AA5  WHERE time >= 2024-11-22 00:00:00  and time <= 2024-11-22 01:00:00 and sensor_id like '5VV__________' and sensor_id like '5VV%19'  GROUP BY date_bin(1h, time), sensor_id having avg(value)>1;
SELECT sensor_id, last(sensor_id) as last_sensor_id,last_by(time,sensor_id) as last_by_sensor_id FROM AA5  WHERE time >= 2024-11-22 00:00:00  and time <= 2024-11-22 01:00:00 and sensor_id like '5VV__________' and sensor_id like '5VV%19'  GROUP BY date_bin(1h, time), sensor_id having avg(value)>1 order by last_by_sensor_id;
select count(*) as count from (SELECT count(*) FROM AA5   GROUP BY sensor_id);
select count(*) as count from (SELECT count(*) FROM AA5   GROUP BY sensor_id) having count(*)>1 and count(*) !=2;
